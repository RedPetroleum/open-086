+// Optional theme image carousel_<tab>.png: drawn centered at full size instead of logo+banner
+bool gui_draw_carousel(tab_t *tab)
+{
+    if (!tab->carousel && !tab->carousel_missing)
+    {
+        char name[64];
+        snprintf(name, sizeof(name), "carousel_%s.png", tab->name);
+        tab->carousel = gui.low_memory_mode ? NULL : rg_gui_get_theme_image(name);
+        tab->carousel_missing = !tab->carousel;
+    }
+    if (!tab->carousel)
+        return false;
+
+    int x = RG_MAX(0, (gui.width - tab->carousel->width) / 2);
+    int y = RG_MAX(0, (gui.height - tab->carousel->height) / 2);
+    rg_gui_draw_image(x, y, 0, 0, false, tab->carousel);
+    return true;
+}
